<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_audit_rule_tree" model="ir.ui.view">
        <field name="name">justech.audit.rule.tree</field>
        <field name="model">justech.audit.rule</field>
        <field name="arch" type="xml">
            <tree string="Reglas de auditoría">
                <field name="name"/>
                <field name="model_description"/>
                <field name="model_name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_justech_audit_rule_form" model="ir.ui.view">
        <field name="name">justech.audit.rule.form</field>
        <field name="model">justech.audit.rule</field>
        <field name="arch" type="xml">
            <form string="Regla de auditoría">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="active" widget="boolean_button" options="{'terminology': 'active'}"/>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="model_id"/>
                        <field name="model_name" readonly="1"/>
                        <field name="model_description" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_justech_audit_rule_search" model="ir.ui.view">
        <field name="name">justech.audit.rule.search</field>
        <field name="model">justech.audit.rule</field>
        <field name="arch" type="xml">
            <search string="Buscar reglas">
                <field name="name"/>
                <field name="model_name"/>
                <field name="model_description"/>
                <filter string="Activas" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Inactivas" name="filter_inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_justech_audit_rule" model="ir.actions.act_window">
        <field name="name">Reglas de auditoría</field>
        <field name="res_model">justech.audit.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_justech_audit_rule_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>

    <menuitem
        id="menu_justech_audit_rule"
        name="Reglas"
        parent="menu_justech_global_audit_root"
        action="action_justech_audit_rule"
        sequence="20"
        groups="base.group_system"
    />
</odoo>
